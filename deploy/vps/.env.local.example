# Template for deploy/vps/.env.local — copy to `.env.local` (gitignored) and fill in.
#   cp .env.local.example .env.local
#
# Note: MCP tokens are NOT configured here. Each user generates their own in the UI
# (Agent → Deployed state) after logging in.

# Session cookie signing key. Generate: openssl rand -hex 32
SESSION_SECRET=

# Google OAuth (console.cloud.google.com → APIs & Services → Credentials → OAuth client ID →
# Web application). Auth turns ON automatically once both are set.
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GCP Vertex AI / Gemini — only if you enable Design & Deploy.
GCP_PROJECT_ID=
CLOUD_ML_REGION=
