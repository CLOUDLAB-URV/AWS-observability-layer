# All config this deployment needs — template. Copy to `.env` (gitignored) and fill it in:
#   cp .env.example .env
# Docker Compose auto-loads `.env` for ${VAR} interpolation, and the backend gets every key here
# via `env_file: .env` in compose.yaml. One file = the whole running stack. The deploy TARGET
# (how to push from your laptop) is separate: .env.deploy. Images are generic — nothing is baked in.

# ---- Images (read by docker compose) ----
IMAGE_BACKEND={username}/aws-architect-backend:latest
IMAGE_FRONTEND={username}/aws-architect-frontend:latest

# ---- Domain & HTTPS (Caddy) ----
# Caddy serves the whole app at https://$DOMAIN (auto Let's Encrypt cert; HTTP→HTTPS).
# Requires a DNS A/AAAA record for $DOMAIN → this server's IP, and ports 80+443 open.
DOMAIN=sigilum.cloud
ACME_EMAIL=you@example.com   # Let's Encrypt account (optional but recommended)

# ---- App ----
# Public base URL of the site. Used to mark session cookies `Secure` under https.
APP_URL=https://sigilum.cloud
# ---- Limits (bootstrap defaults — the in-app admin panel can override them) ----
# Overrides made from the admin panel persist in the app_data volume (persistence/settings.json),
# so they survive redeploys and migrate with the rest of the data; these env values only apply
# while no override is set. Admin accounts are exempt from every limit.
# Max number of users that can register. The next new account is blocked (403).
MAX_USERS=30
# Max sigils (diagrams) each user may own; further new-sigil pushes are rejected (403).
MAX_SIGILS_PER_USER=20
# Max MCP tokens each user may hold at once.
MAX_TOKENS_PER_USER=3
# Max LLM (Gemini) tokens each user may spend per calendar month (resets on the 1st).
# Usage is tracked per user in the app_data volume and shown in the admin panel.
MAX_LLM_TOKENS_PER_MONTH=2000000

# ---- App availability (controls BOTH the UI and the API) ----
# No value / empty = ENABLED. Set to false to disable the app everywhere (front + back).
AGENT_ENABLED=true

# ---- Secrets (keep private) ----
# Signing key for session cookies. Keep secret; rotating it logs everyone out. openssl rand -hex 32
SESSION_SECRET=
# SMTP for email verification codes (internal login). Set these to email codes; leave empty in
# local dev and the backend will log the code instead. Gmail: use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sigilum <no-reply@example.com>
# GCP Vertex AI / Gemini — used by the Agent visualizer (diagram render + auto-naming) AND by
# Design. The backend authenticates via a service-account key:
#   1) create a service account with role "Vertex AI User" in GCP_PROJECT_ID, download its JSON key
#   2) put the key on the host (OUTSIDE this folder so it isn't synced), e.g. /home/<user>/gcp-key.json
#   3) set GCP_KEY_PATH to that host path; compose mounts it at /secrets/gcp-key.json
GCP_PROJECT_ID=
CLOUD_ML_REGION=
GCP_KEY_PATH=
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-key.json

# ---- LLM throughput ----
# Max concurrent Gemini calls (rest queue FIFO). Vertex uses dynamic shared quota, so under
# bursts (many users pushing sigils at once) capping + built-in 429 backoff avoids failures.
# Default 16 sustains ~20 users pushing every 30s (load-tested; see loadtest/README.md).
LLM_MAX_CONCURRENT=16
