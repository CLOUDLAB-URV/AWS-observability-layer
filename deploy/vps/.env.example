# All config this deployment needs — template. Copy to `.env` (gitignored) and fill it in:
#   cp .env.example .env
# Docker Compose auto-loads `.env` for ${VAR} interpolation, and the backend gets every key here
# via `env_file: .env` in compose.yaml. One file = the whole running stack. The deploy TARGET
# (how to push from your laptop) is separate: .env.deploy. Images are generic — nothing is baked in.

# ---- Images (read by docker compose) ----
IMAGE_BACKEND={username}/aws-architect-backend:latest
IMAGE_FRONTEND={username}/aws-architect-frontend:latest

# ---- Domain & HTTPS (Caddy) ----
# Caddy serves the whole app at https://$DOMAIN (auto Let's Encrypt cert; HTTP→HTTPS).
# Requires a DNS A/AAAA record for $DOMAIN → this server's IP, and ports 80+443 open.
DOMAIN=diagrams.example.com
ACME_EMAIL=you@example.com   # Let's Encrypt account (optional but recommended)

# ---- App ----
# Public base URL: used to build the OAuth redirect URI and to mark cookies Secure. Must match
# the "Authorized redirect URI" registered in Google (APP_URL + /api/auth/google/callback).
APP_URL=https://diagrams.example.com
# Max number of users that can register via Google login. The next new account is blocked (403).
MAX_USERS=30

# ---- Modes available (control BOTH the UI and the API) ----
# No value / empty = ENABLED. Set to false to disable a mode everywhere (front + back).
AGENT_ENABLED=true
DESIGN_ENABLED=false        # off: needs uv/python + AWS creds (not in the image) to actually run

# ---- Secrets (keep private) ----
# Signing key for session cookies. Keep secret; rotating it logs everyone out. openssl rand -hex 32
SESSION_SECRET=
# Google OAuth (console.cloud.google.com → APIs & Services → Credentials → OAuth client ID →
# Web application). Auth turns ON automatically when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GCP Vertex AI / Gemini — only needed if you enable Design & Deploy (DESIGN_ENABLED=true).
GCP_PROJECT_ID=
CLOUD_ML_REGION=
