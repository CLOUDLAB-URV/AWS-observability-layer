# Non-secret config for this deployment (committed). Docker Compose auto-loads this file:
#   - IMAGE_*/DOMAIN/ACME_EMAIL interpolate compose.yaml
#   - APP_URL/MAX_USERS/*_ENABLED are injected into the backend (see compose.yaml)
# Secrets live in .env.local (gitignored). The images are generic — nothing is baked in.

# ---- Images (read by docker compose) ----
IMAGE_BACKEND=apozo04/aws-architect-backend:latest
IMAGE_FRONTEND=apozo04/aws-architect-frontend:latest

# ---- Domain & HTTPS (Caddy) ----
# Caddy serves the whole app at https://$DOMAIN (auto Let's Encrypt cert; HTTP→HTTPS).
# Requires a DNS A/AAAA record for $DOMAIN → this server's IP, and ports 80+443 open.
DOMAIN=diagrams.alejandropozo.com
ACME_EMAIL=alejandropozorisquez04@gmail.com   # Let's Encrypt account (optional but recommended)

# ---- App ----
# Public base URL: used to build the OAuth redirect URI and to mark cookies Secure. Must match
# the "Authorized redirect URI" registered in Google (APP_URL + /api/auth/google/callback).
APP_URL=https://diagrams.alejandropozo.com
# Max number of users that can register via Google login. The next new account is blocked (403).
MAX_USERS=30

# ---- Modes available (control BOTH the UI and the API) ----
# No value / empty = ENABLED. Set to false to disable a mode everywhere (front + back).
AGENT_ENABLED=true
DESIGN_ENABLED=false        # off: needs uv/python + AWS creds (not in the image) to actually run
