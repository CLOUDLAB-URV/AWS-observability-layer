# Single, centralized config for this deployment. Docker Compose auto-loads this file:
#   - the IMAGE_*/PORT vars are used to interpolate compose.yaml
#   - the app vars below are injected into the backend container (see compose.yaml)
# The images are generic (nothing baked in) — everything that defines THIS deployment lives here.

# ---- Images (read by docker compose) ----
IMAGE_BACKEND=apozo04/aws-architect-backend:latest
IMAGE_FRONTEND=apozo04/aws-architect-frontend:latest

# ---- Domain & HTTPS (Caddy) ----
# Caddy serves the whole app at https://$DOMAIN (auto Let's Encrypt cert; HTTP→HTTPS).
# Requires a DNS A/AAAA record for $DOMAIN → this server's IP, and ports 80+443 open.
DOMAIN=diagrams.alejandropozo.com
ACME_EMAIL=alejandropozorisquez04@gmail.com   # Let's Encrypt account (optional but recommended)

# ---- Modes available (control BOTH the UI and the API) ----
# No value / empty = ENABLED. Set to false to disable a mode everywhere (front + back).
AGENT_ENABLED=true
DESIGN_ENABLED=false        # off: needs uv/python + AWS creds (not in the image) to actually run

# ---- Integration / secrets ----
# Shared token the MCP server (diagram-state-visualizer-mcp) must send. Rotate: openssl rand -hex 24
VISUALIZER_TOKEN=795ca3d1f483a08b138f77609d71fdd5d256dcf21f32a4b3
# Only needed if you enable Design & Deploy (GCP Vertex AI / Gemini).
GCP_PROJECT_ID=aws-diagramer
CLOUD_ML_REGION=us-central1
