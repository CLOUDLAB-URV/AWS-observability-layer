# Target for push-deploy.sh — copy to `.env.deploy` (gitignored) and adjust.
#   cp .env.deploy.example .env.deploy
#
# push-deploy.sh reads this to know WHERE to deploy. It is local-only and never uploaded.

# SSH target: an alias from ~/.ssh/config (e.g. "vps") or "user@host".
SSH_TARGET=

# SSH port (optional; leave 22 unless your VPS uses another).
SSH_PORT=22

# Absolute path on the VPS where the stack lives. Must be writable by the SSH user
# (create it once, or use a path under the user's home, e.g. /home/youruser/aws-architect).
REMOTE_DIR=
