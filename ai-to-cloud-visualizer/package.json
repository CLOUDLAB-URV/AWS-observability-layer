{
  "name": "ai-to-cloud-visualizer",
  "displayName": "AI-to-cloud-visualizer",
  "description": "A VSCode extension which parses the json requests provided to the AWS MCP for creating and deleting AWS resources and translates the result in real time to a visuali iaaram.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-to-cloud.toggleServer",
        "title": "Cloud Visualizer: Start/Stop Server"
      },
      {
        "command": "ai-to-cloud.startServer",
        "title": "Cloud Visualizer: Start Server"
      },
      {
        "command": "ai-to-cloud.stopServer",
        "title": "Cloud Visualizer: Stop Server"
      },
      {
        "command": "ai-to-cloud.createProject",
        "title": "Cloud Visualizer: Create New Project"
      },
      {
        "command": "ai-to-cloud.changeActiveProject",
        "title": "Cloud Visualizer: Change Active Project"
      },
      {
        "command": "ai-to-cloud.openProjectAll",
        "title": "Cloud Visualizer: Open Project (All)"
      },
      {
        "command": "ai-to-cloud.openProjectQueue",
        "title": "Cloud Visualizer: Open Project Queue"
      },
      {
        "command": "ai-to-cloud.openProjectDiagram",
        "title": "Cloud Visualizer: Open Project Diagram"
      },
      {
        "command": "ai-to-cloud.openProjectWorkflow",
        "title": "Cloud Visualizer: Open Project Workflow"
      },
      {
        "command": "ai-to-cloud.openProjectWebview",
        "title": "Cloud Visualizer: Open Project Webview"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "pnpm run lint",
    "test": "NODE_NO_WARNINGS=1 vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "globals": "^16.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@terrastruct/d2": "^0.1.33",
    "express": "^5.2.1",
    "ws": "^8.20.1"
  }
}