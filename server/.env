# Centralized backend config. Committed (NON-secret only). Secrets live in .env.local.
#
# Feature availability:
#   - In DEVELOPMENT (default, NODE_ENV != production) EVERYTHING is enabled automatically
#     and these flags are IGNORED — you always get the full app locally.
#   - In PRODUCTION (NODE_ENV=production) only what is listed here as enabled is available;
#     anything not set is OFF. List just the features that should be live in prod.
#
# Available in production (AGENT_ENABLED = the deployed-state visualizer / MCP):
AGENT_ENABLED=true
# Design & Deploy (LangGraph chat/deploy/teardown) is not prod-ready yet — leave it off in
# production by NOT enabling it here. Uncomment when ready:
# DESIGN_ENABLED=true
