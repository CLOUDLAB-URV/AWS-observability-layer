# Backend environment template. The server loads .env.local (secrets) then .env (shared
# config); .env.local and the real OS environment win over .env. NODE_ENV defaults to
# "development". Copy secrets into .env.local (GITIGNORED); keep .env non-secret.

# --- Secrets (put real values in .env.local, GITIGNORED) ------------------------
# GCP project hosting Vertex AI / Gemini.
GCP_PROJECT_ID=aws-diagramer
# Physical Vertex AI region (NOT "global").
CLOUD_ML_REGION=us-central1
# Shared token for the deployed-state MCP visualizer (env-token shortcut). Use the SAME
# value in the MCP server's env.
VISUALIZER_TOKEN=viz_local_dev_2026

# --- Feature availability -------------------------------------------------------
# In DEVELOPMENT everything is enabled automatically and these are IGNORED. In PRODUCTION
# (NODE_ENV=production) only the features enabled here are available; unset = OFF.
# Accepts 1/true/yes/on.
AGENT_ENABLED=true       # Agent (MCP) deployed-state visualizer
# DESIGN_ENABLED=true    # Design & Deploy (LangGraph) — enable when prod-ready
