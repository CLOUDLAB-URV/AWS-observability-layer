{
  "name": "sigilum-mcp",
  "version": "1.7.0",
  "description": "Self-contained MCP server for Sigilum: the agent reports the delta of deployed AWS changes (upsert/delete) and it renders a live sigil (architecture diagram) of what is actually deployed in AWS. Resume earlier sigils by name via list_sigils + load_sigil.",
  "type": "module",
  "bin": {
    "sigilum-mcp": "index.js"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "match.js",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aws",
    "aws-cli",
    "diagram",
    "sigilum",
    "visualizer"
  ],
  "license": "MIT",
  "author": "Alejandro Pozo Risquez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CLOUDLAB-URV/AWS-observability-layer.git",
    "directory": "mcp-visualizer"
  },
  "homepage": "https://github.com/CLOUDLAB-URV/AWS-observability-layer/tree/main/mcp-visualizer#readme",
  "bugs": {
    "url": "https://github.com/CLOUDLAB-URV/AWS-observability-layer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check index.js",
    "test": "node --test",
    "prepublishOnly": "node --check index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
